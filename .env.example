# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Generative AI
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Push Notifications (VAPID Keys)
# Generate VAPID keys with: npm run generate-vapid-keys
PUSH_NOTIFICATIONS_SUBJECT=mailto:your-email@example.com
PUSH_NOTIFICATIONS_PUBLIC_KEY=your_vapid_public_key_here
PUSH_NOTIFICATIONS_PRIVATE_KEY=your_vapid_private_key_here
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Optional: Analytics
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id
